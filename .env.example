# 数据库文件在服务器上的绝对路径（持久化目录，不随发布版本变动）
DATABASE_PATH=/var/www/totalkai/data/totalkai.db

# 站点对外地址，用于 Metadata 与 sitemap 绝对链接
SITE_URL=https://totalk.ai

# 管理后台口令，至少 8 位
ADMIN_PASSWORD=change-me-please

# 会话 Cookie 的 HMAC 密钥，至少 16 位
SESSION_SECRET=at-least-16-characters-long

# 应用监听端口，Caddy 反代到此端口
PORT=3000
